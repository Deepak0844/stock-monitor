# Copy to .env and fill in. Never commit .env.
# Use URL-safe values (letters and digits) for the two passwords, because they go inside database URLs:
#   openssl rand -hex 24

# Database owner password (used only by the one-off migrate step and PostgreSQL itself)
POSTGRES_PASSWORD=
# Password for the restricted login role the API and worker use
APP_DB_PASSWORD=

# Encrypts saved supplier sessions and the Shopify token. Exactly 32 random bytes, base64:
#   openssl rand -base64 32
# Back this up separately (for example in a password manager). Without it, saved sessions are unreadable.
APP_ENCRYPTION_KEY=

# true behind HTTPS (normal use). false only for plain-http local runs.
COOKIE_SECURE=true
# true only behind a reverse proxy that overwrites X-Forwarded-For. Otherwise leave false.
TRUST_PROXY=false
LOG_LEVEL=info

# The browser service: the isolated container that opens supplier websites. Set both to turn on supplier login,
# or leave both out. The address is on the private network, and the token is a shared secret of at least 32 characters:
#   openssl rand -hex 24
BROWSER_SERVICE_URL=
BROWSER_CONTROL_TOKEN=
# The address you open the app at, for example https://stock.example.com. The live login screen only accepts pages from
# this exact origin. Leave it out for a local run at http://localhost:3000.
APP_ORIGIN=
# The browser service's VNC port. Leave it as it is unless you changed it.
BROWSER_VNC_PORT=5900
