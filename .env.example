# Copy to .env and fill in. Never commit .env.
# Use URL-safe values (letters and digits) for the two passwords, because they go inside database URLs:
#   openssl rand -hex 24

# Database owner password (used only by the one-off migrate step and PostgreSQL itself)
POSTGRES_PASSWORD=
# Password for the restricted login role the API and worker use
APP_DB_PASSWORD=

# Encrypts saved supplier sessions and the Shopify token. Exactly 32 random bytes, base64:
#   openssl rand -base64 32
# Back this up separately (for example in a password manager). Without it, saved sessions are unreadable.
APP_ENCRYPTION_KEY=

# true behind HTTPS (normal use). false only for plain-http local runs.
COOKIE_SECURE=true
# true only behind a reverse proxy that overwrites X-Forwarded-For. Otherwise leave false.
TRUST_PROXY=false
LOG_LEVEL=info

# The browser service: the isolated container that opens supplier websites. This one secret lets the API and worker
# prove themselves to it. docker-compose.yml gives the same value to the browser container. At least 32 characters:
#   openssl rand -hex 24
BROWSER_CONTROL_TOKEN=

# How the live login window starts. `controlled` (the default) is launched and driven by our automation tool. `plain` is
# an ordinary browser that nothing controls while you log in, read only when you press I'm logged in. Try `plain` if a
# supplier's captcha rejects a login you solved correctly. Change it, then run `docker compose up -d --build`.
LOGIN_WINDOW_MODE=controlled
# Your real timezone and browser language, so the login window agrees with where you really are (the browser container
# runs in UTC otherwise). Example: BROWSER_TIMEZONE=Asia/Kolkata and BROWSER_LANGUAGE=en-IN. Blank keeps the defaults.
BROWSER_TIMEZONE=
BROWSER_LANGUAGE=

# The address you open the app at, for example https://stock.example.com. The live login screen only accepts pages
# from this exact origin. Leave it blank for a local run at http://localhost:3000.
APP_ORIGIN=

# Only when running the API outside Docker Compose. Compose sets these for you.
# BROWSER_SERVICE_URL=http://127.0.0.1:8080
# BROWSER_VNC_PORT=5900
